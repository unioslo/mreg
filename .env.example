# mreg configuration example. Copy to `.env` and uncomment what you need.
# Values shown are defaults, or examples for options that are unset by default.
# Option descriptions and value formats: README.md ("Environment variables") and docs/env.md.

# --- Django / VS Code (README: Django Configuration for VS Code) ---
MANAGE_PY_PATH=manage.py
DJANGO_SETTINGS_MODULE=mregsite.settings

# --- Django core (README: Django Core Configuration) ---
# MREG_SECRET_KEY='change-me-to-a-long-random-string'
# MREG_DEBUG=false
# MREG_ALLOWED_HOSTS=127.0.0.1,localhost
# MREG_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# MREG_LANGUAGE_CODE=en-us
# MREG_TIME_ZONE=Europe/Oslo
# MREG_USE_I18N=true
# MREG_USE_TZ=true
# MREG_STATIC_URL=/static/
# MREG_STATIC_ROOT=static/

# --- Database (README: Database Configuration) ---
# MREG_DB_ENGINE=django.db.backends.postgresql
# MREG_DB_NAME=mreg
# MREG_DB_USER=mreg
# MREG_DB_PASSWORD=
# MREG_DB_HOST=localhost
# MREG_DB_PORT=5432
# MREG_DB_CONN_MAX_AGE=0

# --- Database pooling (README: Database Connection Pooling) ---
# MREG_DB_POOL_ENABLED=true
# MREG_DB_POOL_MIN_SIZE=5
# MREG_DB_POOL_MAX_SIZE=25
# MREG_DB_POOL_MAX_IDLE=300
# MREG_DB_POOL_MAX_LIFETIME=3600
# MREG_DB_PSYCOPG_CONNECT_TIMEOUT=5
# MREG_DB_PSYCOPG_OPTIONS='-c statement_timeout=30000'

# --- Logging (README: Logging Configuration, docs/env.md) ---
# MREG_LOG_LEVEL=CRITICAL
# MREG_LOG_FILE_NAME=logs/app.log
# MREG_LOG_FILE_SIZE=52428800
# MREG_LOG_FILE_COUNT=10
# MREG_LOG_CONSOLE_ENABLED=true
# MREG_LOGGING_MAX_BODY_LENGTH=3000
# MREG_REQUESTS_THRESHOLD_SLOW=1000
# MREG_REQUESTS_LOG_LEVEL_SLOW=WARNING
# MREG_REQUESTS_THRESHOLD_VERY_SLOW=5000
# MREG_REQUESTS_LOG_LEVEL_VERY_SLOW=CRITICAL

# --- Network policies (README: Network Policy Configuration) ---
# MREG_NO_PROTECTED_POLICY_ATTRIBUTES=false
# MREG_PROTECTED_POLICY_ATTRIBUTES='isolated=The network uses client isolation.,restricted'
# MREG_REQUIRED_POLICY_ATTRIBUTES=isolated,restricted
# MREG_MAX_COMMUNITES_PER_NETWORK=20
# MREG_MAP_GLOBAL_COMMUNITY_NAMES=false
# MREG_GLOBAL_COMMUNITY_TEMPLATE_PATTERN=community
# MREG_COMMUNITY_TEMPLATE_PATTERN_ALLOWED_REGEX='^[a-zA-Z0-9_]+$'
# MREG_COMMUNITY_TEMPLATE_PATTERN_MAX_LENGTH=100
# MREG_REQUIRE_MAC_FOR_BINDING_IP_TO_COMMUNITY=true
# MREG_REQUIRE_VLAN_FOR_NETWORK_TO_HAVE_COMMUNITY=false

# --- LDAP (README: LDAP Configuration) ---
# MREG_AUTH_LDAP_SERVER_URI=ldap://ldap.example.com
# MREG_AUTH_LDAP_USER_DN_TEMPLATE='uid=%(user)s,ou=users,dc=example,dc=com'
# MREG_AUTH_LDAP_START_TLS=true
# MREG_AUTH_LDAP_CACHE_TIMEOUT=3600
# MREG_AUTH_LDAP_BIND_DN='cn=mreg,ou=services,dc=example,dc=com'
# MREG_AUTH_LDAP_BIND_PASSWORD=
# MREG_AUTH_LDAP_BIND_AS_AUTHENTICATING_USER=false
# MREG_AUTH_LDAP_ALWAYS_UPDATE_USER=true
# MREG_AUTH_LDAP_USER_ATTR_MAP=first_name=givenName,last_name=sn,email=mail
# MREG_AUTH_LDAP_MIRROR_GROUPS=admins,operators
# MREG_AUTH_LDAP_GLOBAL_OPTIONS=OPT_REFERRALS=0,OPT_NETWORK_TIMEOUT=30
# MREG_AUTH_LDAP_GROUP_TYPE=MemberDNGroupType
# MREG_AUTH_LDAP_GROUP_ARGS=member,cn
# MREG_AUTH_LDAP_GROUP_SEARCH_BASE_DN='OU=groups,DC=example,DC=com'
# MREG_AUTH_LDAP_GROUP_SEARCH_SCOPE=SUBTREE
# MREG_AUTH_LDAP_GROUP_SEARCH_FILTER='(objectClass=group)'
# MREG_LDAP_GROUP_ATTR=memberof
# MREG_LDAP_GROUP_RE='^cn=(?P<group_name>[\w\-]+),cn=netgroups,'

# --- LDAP directory refresh (docs/env.md: Directory refresh) ---
# MREG_LDAP_REFRESH_LOCAL_TOKENS=false
# MREG_LDAP_REFRESH_SECONDS=300
# MREG_LDAP_GRACE_SECONDS=3600
# MREG_LDAP_RETRY_SECONDS=30
# MREG_LDAP_TIMEOUT_SECONDS=5

# --- Keycloak / OIDC (docs/env.md, docs/authentication.md) ---
# MREG_OIDC_ENABLED=false
# MREG_OIDC_ISSUER=https://keycloak.example.com/realms/example
# MREG_OIDC_AUDIENCE=mreg
# MREG_OIDC_JWKS_URL=https://keycloak.example.com/realms/example/protocol/openid-connect/certs
# MREG_OIDC_USERNAME_CLAIM=preferred_username
# MREG_OIDC_ALLOWED_CLIENT_IDS=mreg-cli,mreg-web
# MREG_OIDC_ALGORITHMS=RS256
# MREG_OIDC_JWKS_TIMEOUT=5
# MREG_OIDC_JWKS_CACHE_SECONDS=300
# MREG_OIDC_JWKS_COOLDOWN_SECONDS=30
# MREG_OIDC_LEEWAY_SECONDS=0

# --- Permission groups (README: Permission Groups) ---
# MREG_SUPERUSER_GROUP=default-super-group
# MREG_ADMINUSER_GROUP=default-admin-group
# MREG_GROUPADMINUSER_GROUP=default-groupadmin-group
# MREG_NETWORK_ADMIN_GROUP=default-networkadmin-group
# MREG_HOSTPOLICYADMIN_GROUP=default-hostpolicyadmin-group
# MREG_DNS_WILDCARD_GROUP=default-dns-wildcard-group
# MREG_DNS_UNDERSCORE_GROUP=default-dns-underscore-group

# --- DNS (README: DNS Configuration) ---
# MREG_TXT_AUTO_RECORDS='example.org=v=spf1 -all'

# --- MQ event publishing (README: MQ Event Publishing) ---
# MREG_MQ_HOST=rabbitmq.example.com
# MREG_MQ_SSL=false
# MREG_MQ_VIRTUAL_HOST=/
# MREG_MQ_EXCHANGE=mreg
# MREG_MQ_DECLARE=false
# MREG_MQ_USERNAME=mreg
# MREG_MQ_PASSWORD=change-me

# --- Sentry (README: Sentry Error Tracking) ---
# MREG_SENTRY_DSN=https://publickey@sentry.example.com/1

# --- Profiling, development only (README: Profiling) ---
# MREG_PROFILING_ENABLED=false
# MREG_SILKY_PYTHON_PROFILER=true
# MREG_SILKY_PYTHON_PROFILER_BINARY=true
# MREG_SILKY_PYTHON_PROFILER_RESULT_PATH=silk/profiles
# MREG_SILKY_META=false
