namespace MREG {
    entity Group;
    entity User in [Group];

    entity Generic;
    entity HostContact;
    entity Cname;
    entity Hinfo;
    entity Loc;
    entity Mx;
    entity Naptr;
    entity NameServer;
    entity PtrOverride;
    entity Sshfp;
    entity Srv;
    entity Txt;
    entity BACnetID;
    entity Community;
    entity HostCommunityMapping;
    entity Label;
    entity Network;
    entity NetworkPolicy;
    entity NetworkPolicyAttribute;
    entity NetworkPolicyAttributeValue;

    entity Host = {
        kind?: String,
        id?: String,
        name?: String,
        path?: String,
        hostname?: String,
        ip?: ipaddr,
        nameLabels?: Set<String>,
    };

    entity Ipaddress = {
        kind?: String,
        id?: String,
        ip?: ipaddr,
    };

    action
