        "sshfp_update",
        "superuser_access",
        "txt_create",
        "txt_delete",
        "txt_read",
        "txt_update",
        "view_label"
    appliesTo {
        principal: User,
        resource: [
            Generic,
            Host,
            HostContact,
            Ipaddress,
            Cname,
            Hinfo,
            Loc,
            Mx,
            Naptr,
            NameServer,
