        "name_server_update",
        "naptr_create",
        "naptr_delete",
        "naptr_read",
        "naptr_update",
        "network_admin_access",
        "network_create",
        "network_delete",
        "network_policy_attribute_create",
        "network_policy_attribute_delete",
        "network_policy_attribute_read",
        "network_policy_attribute_update",
        "network_policy_attribute_value_create",
